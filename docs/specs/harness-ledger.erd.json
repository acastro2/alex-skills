{
 "schema_version": 1,
 "diagram_type": "erd",
 "meta": {
  "title": "Harness ledger (ledger.db): proposed SQLite schema",
  "subtitle": "Proposed columns, not yet in the spec. One domain per module (D53). SQLite storage classes; time columns are Unix ms. Every table has session_id and most have journal_seq: those links are in the columns but only the key ones are drawn.",
  "locale": "en",
  "output": "harness-ledger.html",
  "quality_profile": "standard",
  "views": [
   {
    "id": "chain",
    "label": "Journal hub",
    "focus": [
     "journal",
     "sessions",
     "rules",
     "bundles",
     "tokens",
     "requests"
    ],
    "note": "Every decision lands in the journal; grants, bundles and send-backs point back at their journal row."
   },
   {
    "id": "auth",
    "label": "Authority",
    "focus": [
     "requests",
     "tokens",
     "applies",
     "page_auth",
     "journal"
    ],
    "note": "A request is rendered and journaled, a token approves it once, an apply spends the token."
   },
   {
    "id": "work",
    "label": "Work and proof",
    "focus": [
     "workers",
     "bundles",
     "worktrees",
     "workstreams",
     "watches"
    ],
    "note": "A worker works in a worktree; its bundle lands the worktree; the waker watches both."
   }
  ]
 },
